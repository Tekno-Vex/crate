{
  "name": "crate-spicetify",
  "version": "0.0.1",
  "private": true,
  "description": "A real album library for your Spotify local files, with an in-app tag editor. Spicetify custom app.",
  "author": "Vivekanandhan Kathirvel",
  "license": "MIT",
  "type": "module",
  "spicetify": {
    "appId": "crate",
    "displayName": "Crate"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --install",
    "install-app": "node scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
